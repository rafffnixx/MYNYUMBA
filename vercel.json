{
  "version": 2,
  "buildCommand": "exit 0",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)\\.(jpg|jpeg|png|gif|svg|ico|css|js|map|json|woff|woff2|ttf|eot|txt|xml|webp|avif)",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}